<?xml version="1.0"?>
<Container version="2">
  <Name>servers-checkin-hub</Name>
  <Repository>ghcr.io/ashanzzz/servers-checkin-hub:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/ashanzzz/servers-checkin-hub/issues</Support>
  <Project>https://github.com/ashanzzz/servers-checkin-hub</Project>
  <Overview>个人工具仓库 — 统一管理 AkileCloud 与 ACCK 双平台自动化工具箱：支持双平台每日自动打卡与 Token 续期、账户资产看板、新机与二手机监控告警、以及具备安全防误购保护锁的选购与试算接口。</Overview>
  <Category>Tools: Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:80]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/ashanzzz/servers-checkin-hub/master/my-servers-checkin-hub.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/ashanzzz/servers-checkin-hub/master/frontend/public/favicon.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <Config Name="WebUI Port" Target="80" Default="3338" Mode="tcp" Description="Web 界面访问端口" Type="Port" Display="always" Required="true" Mask="false">3338</Config>

  <Config Name="Data Volume" Target="/app/data" Default="/mnt/user/appdata/akile-monitor" Mode="rw" Description="数据持久化目录（SQLite 数据库、配置缓存）" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/akile-monitor</Config>

  <Config Name="AKILE_TOKEN" Target="AKILE_TOKEN" Default="" Mode="" Description="AkileCloud API Token。从 akile.ai 获取，用于调用监控与打卡。" Type="Variable" Display="always" Required="false" Mask="true"></Config>

  <Config Name="ACCK_TOKEN" Target="ACCK_TOKEN" Default="" Mode="" Description="ACCK API Token。从 acck.io 获取，用于打卡与资产管理。" Type="Variable" Display="always" Required="false" Mask="true"></Config>

  <Config Name="PUBLIC_READ_TOKEN" Target="PUBLIC_READ_TOKEN" Default="" Mode="" Description="第三方只读 API 密钥（可选）。配置后可通过 /api/read/v1 读取公开机器数据。" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="PUBLIC_CONTROL_TOKEN" Target="PUBLIC_CONTROL_TOKEN" Default="" Mode="" Description="第三方可写控制 API 密钥（可选）。配置后可通过 /api/control/v1 控制后端刷新与设置。" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="TZ" Target="TZ" Default="Asia/Shanghai" Mode="" Description="容器时区（用于日志时间戳和定时任务）" Type="Variable" Display="advanced" Required="false" Mask="false">Asia/Shanghai</Config>
</Container>
